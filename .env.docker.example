APP_NAME="Laravel Search API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_PORT=8000

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_PORT=3306
DB_DATABASE=laravel_search_api
DB_USERNAME=search_api
DB_PASSWORD=local-search-change-me

MYSQL_DATABASE=laravel_search_api
MYSQL_USER=search_api
MYSQL_PASSWORD=local-search-change-me
MYSQL_ROOT_PASSWORD=local-root-change-me
MYSQL_BUFFER_POOL_SIZE=4G
MYSQL_MAX_CONNECTIONS=150

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
